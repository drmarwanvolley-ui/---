<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- شعار سباك جدة -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="شعار سباك جدة" />

        <!-- العنوان الرئيسي -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سباك جدة للسباكة والخدمات الصحية"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- نبذة الخبرة والمقر -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نشاط متخصص في أعمال السباكة والخدمات الصحية في مدينة جدة، بخبرة تمتد 15 سنة وفريق يضم أكثر من 10 فنيين. مقرنا في حي الصفا، ونخدم أحياء جدة المختلفة."
            android:textSize="14sp"
            android:textColor="#4B5563"
            android:gravity="center"
            android:background="#EFF6FF"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- قائمة الخدمات -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ماذا نقدم:\n- سباكة عامة وإصلاح الأعطال اليومية\n- تأسيس وصيانة السباكة\n- تركيب الأدوات الصحية\n- تسليك المجاري والبيارات\n- كشف تسربات المياه\n- مكافحة الحشرات\n- مقاولات الترميم والتكسير"
            android:textSize="14sp"
            android:textColor="#1F2937"
            android:lineSpacingExtra="6dp"
            android:paddingStart="8dp"
            android:layout_marginBottom="24dp" />

        <!-- زر زيارة الموقع الإلكتروني -->
        <Button
            android:id="@+id/btnWebsite"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="تعرف على تفاصيل الخدمات (زيارة الموقع)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
